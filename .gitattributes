data/**/*.nc filter=lfs diff=lfs merge=lfs -text
data/**/*.npz filter=lfs diff=lfs merge=lfs -text
# the BCM catchment series are ~25 MB each -- 60x any other tracked CSV
data/reference/bcm/*_catchments_monthly.csv filter=lfs diff=lfs merge=lfs -text
# the CalSim3 rim arcs as mm/month (8.8 MB, 235k rows), generated by data/targets/calsim3/build_calsim_arcs.py
data/targets/calsim3/calsim3_inflow_monthly_mm.csv filter=lfs diff=lfs merge=lfs -text
# the arcs' observed training months (42k rows), generated by the same builder
data/targets/calsim3/arc_obs_mask.csv filter=lfs diff=lfs merge=lfs -text
# self-contained validation atlases (images embedded): keep them out of text diffs and language stats
artifacts/**/*.html linguist-generated=true -diff
# the atlases (~20 MB each) and the daily-flow archives (2-8 MB) are binary-sized
artifacts/**/*.html filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.npz filter=lfs diff=lfs merge=lfs -text
# the rim-inflow product of each forcing (196 arcs x every month, 7-11 MB) and the tier-2 pass
# it was made from (9-35 MB)
artifacts/product/calsim3/*/rim_inflow_monthly.csv filter=lfs diff=lfs merge=lfs -text
artifacts/product/calsim3/*/tier2/*.csv filter=lfs diff=lfs merge=lfs -text
# the daily flow of the 15 CDEC watersheds, WY1922-2018 (15 x 35,000 days)
artifacts/product/15cdec/*/flow_daily.csv filter=lfs diff=lfs merge=lfs -text
