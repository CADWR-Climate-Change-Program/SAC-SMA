data/**/*.nc filter=lfs diff=lfs merge=lfs -text
data/**/*.npz filter=lfs diff=lfs merge=lfs -text
# the BCM catchment series are ~25 MB each -- 60x any other tracked CSV
data/region/bcm/*_catchments_monthly.csv filter=lfs diff=lfs merge=lfs -text
# the CalSim3 rim arcs as mm/month (8.8 MB, 235k rows), generated by dataprep/build_calsim_arcs.py
data/calsim/calsim3_inflow_monthly_mm.csv filter=lfs diff=lfs merge=lfs -text
# the arcs' observed training months (42k rows), generated by the same builder
data/calsim/arc_obs_mask.csv filter=lfs diff=lfs merge=lfs -text
# self-contained validation atlases (images embedded): keep them out of text diffs and language stats
artifacts/**/*.html linguist-generated=true -diff
# the multifamily dPL runs' atlases (~20 MB each) and daily-flow dumps (2-8 MB) are binary-sized
artifacts/dpl/multifamily/**/*.html filter=lfs diff=lfs merge=lfs -text
artifacts/dpl/multifamily/**/*.npz filter=lfs diff=lfs merge=lfs -text
