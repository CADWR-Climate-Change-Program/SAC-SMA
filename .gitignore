# --- local only -------------------------------------------------------------------------
# editor files, the coding assistant's notes, and scratch (tmp/ also holds the original
# reference material the tracked data/ store was derived from)
*sublime*
CLAUDE.md
.claude*
tmp/

# --- Python and build output ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
*.log
docs/_build/

# --- data/ ------------------------------------------------------------------------------
# Everything under data/ is tracked (data/README.md; the large stores through git-LFS,
# .gitattributes) except:
# the raw raster stage the grid attributes are sampled from (large; usually on another drive)
data/inputs/grid/raw_gis/
# the raster samples of every grid cell: an input of data/inputs/grid/build_region_statics.py
# that the tracked data/inputs/grid/{soilveg_continuous,lai_climatology}.csv fully contain
data/inputs/grid/soilveg_continuous_raster.csv
data/inputs/grid/lai_climatology_raster.csv
# the workbook delivered with the BCM release (local; no code reads it)
data/reference/bcm/CalBasins_v8_DWR_FNF_PRISM19.xlsx
# this machine's paths for the build scripts (data/local_paths.example.toml)
data/local_paths.toml
# written by data/targets/dwr_unimpaired/check_uf_locations.py for GIS viewing; carries a write timestamp
data/targets/dwr_unimpaired/verification/uf_dissolved.gpkg

# --- artifacts/ -------------------------------------------------------------------------
# Everything under artifacts/ is tracked (artifacts/README.md) except its local part: the
# caches, scratch runs, the large outputs of each run, and the runs that were not adopted
artifacts/_local/
